@baseUrl = http://localhost:8080
@authToken = replace-with-a-valid-courseplatform-jwt
@couponAdminKey = replace-with-Dropbox__CouponAdminKey
@courseId = -1

### List Dropbox course IDs first, then set @courseId to the selected course
GET {{baseUrl}}/api/dropbox/courses

### Generate ten single-use seven-day coupons for the selected course
POST {{baseUrl}}/api/admin/dropbox-coupons
Content-Type: application/json
X-Coupon-Admin-Key: {{couponAdminKey}}

{
  "type": "week",
  "count": 10,
  "courseId": {{courseId}}
}

### Generate a single-use coupon valid for 30 days
POST {{baseUrl}}/api/admin/dropbox-coupons
Content-Type: application/json
X-Coupon-Admin-Key: {{couponAdminKey}}

{
  "type": "month",
  "count": 1,
  "courseId": {{courseId}}
}

### Generate a single-use permanent coupon
POST {{baseUrl}}/api/admin/dropbox-coupons
Content-Type: application/json
X-Coupon-Admin-Key: {{couponAdminKey}}

{
  "type": "forever",
  "count": 1,
  "courseId": {{courseId}}
}

### Generate a 24-hour test coupon for the selected course
POST {{baseUrl}}/api/admin/dropbox-coupons
Content-Type: application/json
X-Coupon-Admin-Key: {{couponAdminKey}}

{
  "type": "test",
  "count": 1,
  "courseId": {{courseId}}
}

### Check access for the selected course
GET {{baseUrl}}/api/dropbox/access?courseId={{courseId}}
Authorization: Bearer {{authToken}}

### Redeem a coupon
POST {{baseUrl}}/api/dropbox/access/redeem
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "coupon": "replace-with-generated-code",
  "courseId": {{courseId}}
}
