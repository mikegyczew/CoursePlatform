{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (.NET)",
      "type": "dotnet",
      "request": "launch",
      "preLaunchTask": "build backend",
      "projectPath": "${workspaceFolder}/Backend.csproj",
      "launchBrowser": false,
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://127.0.0.1:5247"
      }
    },
    {
      "name": "Frontend (Vite)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/../frontend",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Frontend + Backend",
      "configurations": [
        "Backend (.NET)",
        "Frontend (Vite)"
      ],
      "stopAll": true
    }
  ]
}