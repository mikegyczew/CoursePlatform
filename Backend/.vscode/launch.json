{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build backend",
      "program": "${workspaceFolder}/bin/Debug/net10.0/Backend.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://127.0.0.1:5247"
      }
    },
    {
      "name": "Frontend (Vite)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --host 127.0.0.1 --port 5176 --strictPort",
      "cwd": "${workspaceFolder}/../frontend"
    }
  ],
  "compounds": [
    {
      "name": "Frontend + Backend",
      "configurations": [
        "Backend (.NET)",
        "Frontend (Vite)"
      ],
      "stopAll": true
    }
  ]
}